APP_NAME="Co-Found"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cofound
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@cofound.io"
MAIL_FROM_NAME="Co-Found"

# ── Frontend (React SPA) ──────────────────────────────────────────────────────
# The URL of the React frontend — used by CORS and Sanctum stateful domains.
#
# Local dev  : FRONTEND_URL=http://localhost:3000
# Production : FRONTEND_URL=https://app.cofound.io
FRONTEND_URL=http://localhost:3000

# ── Sanctum SPA Auth ──────────────────────────────────────────────────────────
# Domains that receive stateful (cookie-based) authentication.
# Must match the frontend origin exactly (no trailing slash).
#
# Local dev  : localhost:3000
# Production : app.cofound.io
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ── Session (cookie-based SPA auth) ──────────────────────────────────────────
# SESSION_DOMAIN controls which domain the session cookie is valid for.
#
# Local dev  : SESSION_DOMAIN=localhost
# Production : SESSION_DOMAIN=.cofound.io   (note the leading dot — covers all subdomains)
SESSION_DOMAIN=localhost

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ML_BASE_URL=
ML_SECRET=

FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_CREDENTIALS=storage/firebase/firebase_service.json
FIREBASE_STORAGE_BUCKET=

# ── Jitsi Meet ──────────────────────────────────────
JITSI_BASE_URL=https://meet.cofound.example.com
JITSI_APP_ID=cofound
JITSI_APP_SECRET=
JITSI_TOKEN_TTL=30
JITSI_TOKEN_REFRESH_INTERVAL=25
JITSI_ROOM_DURATION=14400
JITSI_RESERVATION_SECRET=

# ── OCR ──────────────────────────────────────
OCR_SERVICE_URL=
OCR_SERVICE_SECRET=same_value_as_OCR_API_SECRET_in_ocr_service_env
OCR_SERVICE_TIMEOUT=60
